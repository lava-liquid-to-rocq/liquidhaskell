  | O -> O
  | S n' -> n'

refl def sf_exp :: base: {MyNat} -> power: {MyNat} -> {MyNat} :=
  destruct power of
  | O -> S O
  | S p -> mult base ((sf_exp base) p)

refl def sndSF :: p: {Natprod} -> {MyNat} :=
