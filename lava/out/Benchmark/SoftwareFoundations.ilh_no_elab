    | SFFalse -> unit

def identity_fn_applied_twice :: f: (f: {SFBool} -> {SFBool})
                                 -> x: (x: {SFBool} -> {{f x == x}}) -> b: {SFBool} -> {{f (f b) == b}} :=
  unit ? (f (f b) === f b ? (x (f b) === b ? (x b proves True) proves True) proves True) ? (unit proves True)

