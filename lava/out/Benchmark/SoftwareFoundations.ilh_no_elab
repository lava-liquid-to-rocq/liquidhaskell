data Modifier := | Minus :: {Modifier} | Natural :: {Modifier} | Plus :: {Modifier}

data Letter := | A :: {Letter} | B :: {Letter} | C :: {Letter} | D :: {Letter} | F :: {Letter}

refl def lower_letter :: l: {Letter} -> {Letter} :=
  destruct l of
  | A -> B
  | B -> C
  | C -> D
  | D -> F
  | F -> F

def lower_letter_F_is_F :: {{lower_letter F == F}} := unit

data Grades := | Grade :: VV: {Letter} -> VV_: {Modifier} -> {Grades}

refl def lower_grade :: g: {Grades} -> {Grades} :=
  destruct g of
  | Grade l m ->
    destruct m of
    | Plus -> Grade l Natural
    | Natural -> Grade l Minus
    | Minus ->
      destruct l of
      | A -> Grade (lower_letter A) Plus
      | B -> Grade (lower_letter B) Plus
      | C -> Grade (lower_letter C) Plus
      | D -> Grade (lower_letter D) Plus
      | F -> Grade F Minus

refl def apply_late_policy :: late_days: {Integer} -> g: {Grades} -> {Grades} :=
  let x_75409328 := late_days < 9
   in destruct x_75409328 of
      | False ->
        let x_88438429 := late_days < 17
         in destruct x_88438429 of
            | False ->
              let x_66644551 := late_days < 21
               in destruct x_66644551 of
                  | False -> lower_grade (lower_grade (lower_grade g))
                  | True -> lower_grade (lower_grade g)
            | True -> lower_grade g
      | True -> g

def lower_grade_F_Minus :: {{lower_grade ((Grade F) Minus) == Grade F Minus}} := unit

def lower_grade_thrice :: {{lower_grade (lower_grade (lower_grade ((Grade B) Minus))) == Grade C Minus}} :=
  unit

def lower_grade_twice :: {{lower_grade (lower_grade ((Grade B) Minus)) == Grade C Natural}} := unit

def no_penalty_for_mostly_on_time :: late_days: {Integer}
                                     -> g: {Grades} -> h: {{late_days < 9}} -> {{apply_late_policy late_days g == g}} :=
  let x_75409328 := late_days < 9
   in destruct x_75409328 of
      | False -> h
      | True -> unit

data Day :=
  | Friday :: {Day}
  | Monday :: {Day}
  | Saturday :: {Day}
  | Sunday :: {Day}
  | Thursday :: {Day}
  | Tuesday :: {Day}
  | Wednesday :: {Day}

refl def next_weekday :: d: {Day} -> {Day} :=
  destruct d of
  | Monday -> Tuesday
  | Tuesday -> Wednesday
  | Wednesday -> Thursday
  | Thursday -> Friday
  | Friday -> Monday
  | Saturday -> Monday
  | Sunday -> Monday

def test_next_weekday :: {{next_weekday (next_weekday Saturday) == Tuesday}} := unit

data Comparison := | Eq :: {Comparison} | Gt :: {Comparison} | Lt :: {Comparison}

refl def letter_comparison :: l1: {Letter} -> l2: {Letter} -> {Comparison} :=
  destruct l1 of
  | A ->
    destruct l2 of
    | A -> Eq
    | B -> Gt
    | C -> Gt
    | D -> Gt
    | F -> Gt
  | B ->
    destruct l2 of
    | A -> Lt
    | B -> Eq
    | C -> Gt
    | D -> Gt
    | F -> Gt
  | C ->
    destruct l2 of
    | A -> Lt
    | B -> Lt
    | C -> Eq
    | D -> Gt
    | F -> Gt
  | D ->
    destruct l2 of
    | A -> Lt
    | B -> Lt
    | C -> Lt
    | D -> Eq
    | F -> Gt
  | F ->
    destruct l2 of
    | A -> Lt
    | B -> Lt
    | C -> Lt
    | D -> Lt
    | F -> Eq

def letter_comparison_eq :: l: {Letter} -> {{letter_comparison l l == Eq}} :=
  destruct l of
  | A -> unit
  | B -> unit
  | C -> unit
  | D -> unit
  | F -> unit

def lower_letter_lowers :: l: {Letter}
                           -> p: {{letter_comparison F l == Lt}} -> {{letter_comparison (lower_letter l) l == Lt}} :=
  destruct l of
  | A -> unit
  | B -> unit
  | C -> unit
  | D -> unit
  | F -> p

refl def modifier_comparison :: m1: {Modifier} -> m2: {Modifier} -> {Comparison} :=
  destruct m1 of
  | Plus ->
    destruct m2 of
    | Plus -> Eq
    | Natural -> Gt
    | Minus -> Gt
  | Natural ->
    destruct m2 of
    | Plus -> Lt
    | Natural -> Eq
    | Minus -> Gt
  | Minus ->
    destruct m2 of
    | Plus -> Lt
    | Natural -> Lt
    | Minus -> Eq

data Color := | Black :: {Color} | Primary :: VV: {RGB} -> {Color} | White :: {Color}

def isred :: c: {Color} -> {SFBool} :=
  destruct c of
  | Black -> SFFalse
  | White -> SFFalse
  | Primary ds_d5TZ ->
    destruct ds_d5TZ of
    | Red -> SFTrue
    | Green -> SFFalse
    | Blue -> SFFalse

refl def monochrome :: c: {Color} -> {SFBool} :=
  destruct c of
  | Black -> SFTrue
  | White -> SFTrue
  | Primary p -> SFFalse
