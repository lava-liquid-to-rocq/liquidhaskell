refl def andb3 :: b1: {SFBool} -> b2: {SFBool} -> b3: {SFBool} -> {SFBool} :=
  destruct b1 of
  | SFTrue ->
    destruct b2 of
    | SFTrue ->
      destruct b3 of
      | SFTrue -> SFTrue
      | SFFalse -> SFFalse
    | SFFalse -> SFFalse
  | SFFalse -> SFFalse

