data SFBit := | B0 :: {SFBit} | B1 :: {SFBit}

data SFBin := | Bin0 :: n: {SFBin} -> {SFBin} | Bin1 :: n: {SFBin} -> {SFBin} | Z :: {SFBin}

refl def bin_to_nat :: m: {SFBin} -> {Integer} :=
  destruct m of
  | Z -> 0
  | Bin0 m' -> 2 * bin_to_nat m'
  | Bin1 m' -> 1 + 2 * bin_to_nat m'

def test_bin_incr4 :: {{bin_to_nat (Bin0 (Bin1 Z)) == 2}} := unit

refl def incr :: m: {SFBin} -> {SFBin} :=
  destruct m of
  | Z -> Bin1 Z
  | Bin0 m' -> Bin1 m'
  | Bin1 m' -> Bin0 (incr m')

def test_bin_incr1 :: {{incr (Bin1 Z) == Bin0 (Bin1 Z)}} := unit

def test_bin_incr2 :: {{incr (Bin0 (Bin1 Z)) == Bin1 (Bin1 Z)}} := unit

