def test_bin_incr5 :: {{bin_to_nat (incr (Bin1 Z)) == 1 + bin_to_nat (Bin1 Z)}} := unit

def test_bin_incr6 :: {{bin_to_nat (incr (incr (Bin1 Z))) == 2 + bin_to_nat (Bin1 Z)}} := unit

