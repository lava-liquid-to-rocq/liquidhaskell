data Nibble := | Bits :: VV: {SFBit} -> VV_: {SFBit} -> VV__: {SFBit} -> VV___: {SFBit} -> {Nibble}

def allzero :: lq_tmp0: {Nibble} -> {SFBool} :=
  destruct lq_tmp0 of
  | Bits ds_d5TQ ds_d5TR ds_d5TS ds_d5TT ->
    destruct ds_d5TQ of
    | B1 -> SFFalse
    | B0 ->
      destruct ds_d5TR of
      | B1 -> SFFalse
      | B0 ->
        destruct ds_d5TS of
        | B1 -> SFFalse
        | B0 ->
          destruct ds_d5TT of
          | B1 -> SFFalse
          | B0 -> SFTrue

data MyNat := | O :: {MyNat} | S :: VV: {MyNat} -> {MyNat}

data Natprod := | Pair :: n1: {MyNat} -> n2: {MyNat} -> {Natprod}

refl def swap_pair :: p: {Natprod} -> {Natprod} :=
  destruct p of
  | Pair x y -> Pair y x

refl def eqb :: n: {MyNat} -> m: {MyNat} -> {SFBool} :=
  destruct n of
  | O ->
    destruct m of
    | O -> SFTrue
    | S m' -> SFFalse
  | S n' ->
    destruct m of
    | O -> SFFalse
    | S m' -> eqb n' m'

refl def fstSF :: p: {Natprod} -> {MyNat} :=
  destruct p of
  | Pair n1 n2 -> n1

refl def leb :: n: {MyNat} -> m: {MyNat} -> {SFBool} :=
  destruct n of
  | O -> SFTrue
  | S n' ->
    destruct m of
    | O -> SFFalse
    | S m' -> leb n' m'

refl def ltb :: n: {MyNat} -> m: {MyNat} -> {SFBool} :=
  destruct n of
  | O ->
    destruct m of
    | O -> SFFalse
    | S m' -> SFTrue
  | S n' ->
    destruct m of
    | O -> SFFalse
    | S m' -> ltb n' m'

refl def minus :: n: {MyNat} -> m: {MyNat} -> {MyNat} :=
  destruct n of
  | O -> O
  | S ds_d5Tn ->
    destruct m of
    | O -> S ds_d5Tn
    | S m' -> minus ds_d5Tn m'

def minus_n_n :: n: {MyNat} -> {{minus n n == O}} :=
  destruct n of
  | O -> unit
  | S n' -> minus_n_n n'

def minustwo :: lq_tmp0: {MyNat} -> {MyNat} :=
  destruct lq_tmp0 of
  | O -> O
  | S ds_d5TN ->
    destruct ds_d5TN of
    | O -> O
    | S n' -> n'

refl def one :: {MyNat} := S O

refl def plus :: n: {MyNat} -> m: {MyNat} -> {MyNat} :=
  destruct n of
  | O -> m
  | S n' -> S ((plus n') m)

def add_0_r :: n: {MyNat} -> {{plus n O == n}} :=
  destruct n of
  | O -> unit
  | S n' -> add_0_r n'

def add_assoc :: n: {MyNat}
                 -> m: {MyNat} -> p: {MyNat} -> {{plus n ((plus m) p) == plus ((plus n) m) p}} :=
  destruct n of
  | O -> unit
  | S n' -> add_assoc n' m p

def add_succ_r :: n: {MyNat} -> m: {MyNat} -> {{plus n (S m) == S ((plus n) m)}} :=
  destruct n of
  | O -> unit
  | S n' -> add_succ_r n' m

refl def mult :: n: {MyNat} -> m: {MyNat} -> {MyNat} :=
  destruct n of
  | O -> O
  | S n' -> plus m ((mult n') m)

refl def factorial :: lq_tmp0: {MyNat} -> {MyNat} :=
  destruct lq_tmp0 of
  | O -> S O
  | S n' -> mult (S n') (factorial n')

def mul_0_r :: n: {MyNat} -> {{mult n O == O}} :=
  destruct n of
  | O -> unit
  | S n' -> mul_0_r n'

def mult_0_1 :: n: {MyNat} -> {{mult O n == O}} := unit

def mult_n_O :: n: {MyNat} -> {{O == mult n O}} :=
  destruct n of
  | O -> unit
  | S n' -> mult_n_O n'

def mult_n_0_m_0 :: p: {MyNat} -> q: {MyNat} -> {{plus ((mult p) O) ((mult q) O) == O}} :=
  mult_n_O p ? (mult_n_O q proves True)

def mult_n_Sm :: n: {MyNat} -> m: {MyNat} -> {{plus ((mult n) m) n == mult n (S m)}} :=
  destruct n of
  | O -> unit
  | S n' -> add_assoc m ((mult n') m) n' ? (add_succ_r ((plus m) ((mult n') m)) n' proves True)

def mult_n_1 :: p: {MyNat} -> {{mult p one == p}} := mult_n_Sm p O ? (mult_n_O p proves True)

def plus_1_1 :: n: {MyNat} -> {{plus one n == S n}} := unit

def plus_1_neq_0 :: n: {MyNat} -> {{plus n one /= O}} :=
  destruct n of
  | O -> unit
  | S ds_d5T8 -> unit

def plus_O_n :: n: {MyNat} -> {{plus O n == n}} := unit

def plus_id_example :: n: {MyNat} -> m: {MyNat} -> z: {{n == m}} -> {{plus n n == plus m m}} :=
  unit

def plus_id_exercise :: n: {MyNat}
                        -> m: {MyNat} -> o: {MyNat} -> p: {{n == m}} -> q: {{m == o}} -> {{plus n m == plus m o}} :=
  unit

def plus_n_Sm :: n: {MyNat} -> m: {MyNat} -> {{S ((plus n) m) == plus n (S m)}} :=
  destruct n of
  | O -> unit
  | S n' -> plus_n_Sm n' m

def add_comm :: n: {MyNat} -> m: {MyNat} -> {{plus n m == plus m n}} :=
  destruct n of
  | O -> add_0_r m
  | S n' -> plus_n_Sm m n' ? (add_comm n' m proves True)

