

data RBin := | RB0 :: n: {n: RBin | n /= RZ} -> {RBin} | RB1 :: n: {RBin} -> {RBin} | RZ :: {RBin}

data Bin := | B0 :: n: {Bin} -> {Bin} | B1 :: n: {Bin} -> {Bin} | Z :: {Bin}

def rbinToBin :: b: {RBin} -> {Bin} :=
  destruct b of
  | RB0 n -> B0 (rbinToBin n)
  | RZ -> Z
  | RB1 n -> B1 (rbinToBin n)
