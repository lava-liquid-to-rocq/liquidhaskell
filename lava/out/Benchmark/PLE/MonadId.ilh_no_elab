

data Identity := | Val :: n: {Integer} -> {Identity}

refl def compose :: vx: {Identity} -> x: (x: {Integer} -> {Identity}) -> {Identity} :=
  destruct vx of
  | Val x_1 -> x x_1

refl def retrn :: v: {Integer} -> {Identity} := Val v

def leftIdentity :: x: {Integer}
                    -> f: (f: {Integer} -> {Identity}) -> {{compose (retrn x) f == f x}} :=
  unit

def rightIdentity :: x: {Identity} -> {{compose x retrn == x}} :=
  destruct x of
  | Val x -> unit
