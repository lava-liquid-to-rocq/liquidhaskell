

def prop2 :: f: (f: {Integer} -> {Integer})
             -> lq_tmp2: (lq_tmp2: {Integer} -> {Integer}) -> x: {Integer} -> {Unit} :=
  unit

refl def compose :: lq_tmp1: (lq_tmp1: {Integer} -> {Integer})
                    -> lq_tmp4: (lq_tmp4: {Integer} -> {Integer}) -> lq_tmp6: {Integer} -> {Integer} :=
  lq_tmp1 (lq_tmp4 lq_tmp6)

def prop1 :: f: (f: {Integer} -> {Integer})
             -> lq_tmp2: (lq_tmp2: {Integer} -> {Integer}) -> x: {Integer} -> {{f (g x) == compose f g x}} :=
  unit
