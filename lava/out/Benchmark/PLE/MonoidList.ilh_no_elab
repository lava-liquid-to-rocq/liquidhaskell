

data L := | C :: VV: {Integer} -> VV_: {L} -> {L} | Emp :: {L}

refl def mappend :: lq_tmp0: {L} -> lq_tmp1: {L} -> {L} :=
  destruct lq_tmp0 of
  | Emp -> lq_tmp1
  | C x xs -> C x ((mappend xs) lq_tmp1)

def mappend_assoc :: xs: {L}
                     -> ys: {L} -> zs: {L} -> {{mappend ((mappend xs) ys) zs == mappend xs ((mappend ys) zs)}} :=
  destruct xs of
  | Emp -> unit
  | C x xs -> mappend_assoc xs ys zs

refl def mempty :: {L} := Emp

def mempty_left :: x: {L} -> {{mappend mempty x == x}} := unit

def mempty_right :: x: {L} -> {{mappend x mempty == x}} :=
  destruct x of
  | Emp -> unit
  | C x xs -> mempty_right xs
