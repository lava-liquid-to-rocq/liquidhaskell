

data MaybeInt := | Just :: VV: {Integer} -> {MaybeInt} | Nothing :: {MaybeInt}

refl def bind :: lq_tmp0: {MaybeInt} -> lq_tmp2: (lq_tmp2: {Integer} -> {MaybeInt}) -> {MaybeInt} :=
  destruct lq_tmp0 of
  | Nothing -> Nothing
  | Just m -> lq_tmp2 m

refl def retrn :: lq_tmp0: {Integer} -> {MaybeInt} := Just lq_tmp0

def left_identity :: x: {Integer}
                     -> f: (f: {Integer} -> {MaybeInt}) -> {{bind (retrn x) f == f x}} :=
  unit

def right_identity :: x: {MaybeInt} -> {{bind x retrn == x}} :=
  destruct x of
  | Nothing -> unit
  | Just x -> unit
